{
  "name": "markdown-grid",
  "version": "0.1.0",
  "description": "Edit Markdown tables in a spreadsheet-style grid in a dedicated tab.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "styles": "node scripts/gen-styles.mjs",
    "dev": "npm run styles && node esbuild.config.mjs",
    "build": "npm run styles && tsc --noEmit && node esbuild.config.mjs production",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run styles && tsc --noEmit && eslint . && vitest run && node esbuild.config.mjs production",
    "version:bump": "node scripts/bump-version.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.20.0",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "obsidian": "latest",
    "tslib": "^2.8.1",
    "typescript": "~5.7.0",
    "vitest": "^2.1.0"
  }
}
